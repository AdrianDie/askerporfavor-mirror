entor-section-height-default\" data-id=\"cbf0b6b\" data-element_type=\"section\" data-settings=\"{&quot;stretch_section&quot;:&quot;section-stretched&quot;}\">\n\t\t\t\t\t\t<div class=\"elementor-container elementor-column-gap-no\">\n\t\t\t\t\t<div class=\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-eb17a71\" data-id=\"eb17a71\" data-element_type=\"column\">\n\t\t\t<div class=\"elementor-widget-wrap elementor-element-populated\">\n\t\t\t\t\t\t<div class=\"elementor-element elementor-element-15d76af elementor-widget elementor-widget-html\" data-id=\"15d76af\" data-element_type=\"widget\" data-widget_type=\"html.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t<section class=\"pf-catering\" style=\"background-color:#0a0a0a; overflow:hidden;\">\r\n\r\n  <!-- HEADER: foto collage + staklena kartica preko -->\r\n  <div style=\"position:relative; display:grid; grid-template-columns:1.3fr 1fr; grid-template-rows:1fr 1fr; gap:2px; height:640px;\">\r\n    <div style=\"grid-row:1 \/ 3; background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/09\/PorFavor-Tapas48401-scaled.jpg'); background-size:cover; background-position:center; filter:grayscale(15%) brightness(0.75);\"><\/div>\r\n    <div style=\"background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/09\/PorFavor-Tapas48398-scaled.jpg'); background-size:cover; background-position:center; filter:grayscale(15%) brightness(0.75);\"><\/div>\r\n    <div style=\"background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/01\/18824237-scaled.jpg'); background-size:cover; background-position:center; filter:grayscale(15%) brightness(0.75);\"><\/div>\r\n\r\n    <div style=\"position:absolute; inset:0; background:linear-gradient(180deg, rgba(0,0,0,0.15) 0%, rgba(0,0,0,0.55) 100%);\"><\/div>\r\n\r\n    <div style=\"position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:min(560px, 88%); text-align:center; padding:55px 40px; background:rgba(10,10,10,0.42); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px); border:1px solid rgba(188,144,107,0.5); box-shadow:0 25px 60px rgba(0,0,0,0.5);\">\r\n      <p style=\"color:#bc906b; font-size:12px; letter-spacing:5px; text-transform:uppercase; margin:0 0 22px;\">PorFavor Catering<\/p>\r\n      <h2 style=\"color:#ffffff; font-size:36px; font-weight:500; line-height:1.35; margin:0 0 22px;\">Smaken av PorFavor<br>servert der du \u00f8nsker det.<\/h2>\r\n      <p style=\"color:#ffffff; font-size:15px; line-height:1.85; opacity:0.8; margin:0;\">\r\n        Fra firmaarrangementer til private feiringer \u2013 vi tar med oss smaken og gjestfriheten fra restauranten, rett til ditt bord.\r\n      <\/p>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <!-- INTRO TEKST -->\r\n  <div style=\"padding:90px 20px 70px; text-align:center;\">\r\n    <p style=\"color:#ffffff; font-size:17px; line-height:2; opacity:0.8; max-width:640px; margin:0 auto;\">\r\n      V\u00e5r catering er laget for \u00e5 deles og best\u00e5r av et n\u00f8ye sammensatt utvalg av autentiske spanske retter, tilberedt med r\u00e5varer av h\u00f8y kvalitet og servert med samme omtanke som i restauranten.\r\n    <\/p>\r\n  <\/div>\r\n\r\n  <!-- MENY: blurred foto pozadina, tekst preko -->\r\n  <div style=\"position:relative; padding:100px 20px;\">\r\n    <div style=\"position:absolute; inset:0; background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2025\/07\/Untitled-12.png'); background-size:cover; background-position:center; filter:blur(6px) brightness(0.28) saturate(1.1); transform:scale(1.08);\"><\/div>\r\n    <div style=\"position:relative; max-width:620px; margin:0 auto; text-align:center;\">\r\n      <p style=\"color:#bc906b; font-size:12px; letter-spacing:5px; text-transform:uppercase; margin:0 0 45px;\">Menyen inkluderer<\/p>\r\n      <div style=\"display:grid; grid-template-columns:1fr 1fr; gap:0 50px;\">\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">Nystekt focaccia med aioli<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">Serranoskinke<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">6 mnd. lagret Manchego<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">Marinerte oliven<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">Patatas Bravas<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; border-bottom:1px solid rgba(188,144,107,0.3); text-align:left;\">Grillede gr\u00f8nnsaker<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; text-align:left;\">Flambert chorizo<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; letter-spacing:0.3px; margin:0; padding:16px 0; text-align:left;\">Kyllingspyd<\/p>\r\n      <\/div>\r\n      <p style=\"color:#ffffff; font-size:14px; line-height:1.8; opacity:0.65; font-style:italic; margin:40px 0 0;\">\r\n        \u00d8nsker du \u00e5 gj\u00f8re opplevelsen enda mer personlig? Vi tilpasser gjerne menyen etter dine \u00f8nsker og behov.\r\n      <\/p>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <!-- PRIS + LEVERING: overlapping glass panel preko slike -->\r\n  <div style=\"position:relative; min-height:520px; display:flex; align-items:center;\">\r\n    <div style=\"position:absolute; inset:0; background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/09\/PorFavor-Tapas48401-scaled.jpg'); background-size:cover; background-position:center; filter:grayscale(20%) brightness(0.55);\"><\/div>\r\n\r\n    <div style=\"position:relative; margin:60px auto; width:min(760px, 90%); background:rgba(12,12,12,0.5); backdrop-filter:blur(16px); -webkit-backdrop-filter:blur(16px); border:1px solid rgba(188,144,107,0.45); box-shadow:0 30px 70px rgba(0,0,0,0.55); padding:60px 50px; display:flex; flex-wrap:wrap; gap:40px; justify-content:space-around; text-align:center;\">\r\n      <div style=\"min-width:200px;\">\r\n        <p style=\"color:#bc906b; font-size:12px; letter-spacing:4px; text-transform:uppercase; margin:0 0 16px;\">Pris<\/p>\r\n        <p style=\"color:#ffffff; font-size:30px; font-weight:500; margin:0;\">595 NOK<\/p>\r\n        <p style=\"color:#ffffff; font-size:13px; opacity:0.7; margin:6px 0 0;\">per person<\/p>\r\n      <\/div>\r\n      <div style=\"min-width:200px;\">\r\n        <p style=\"color:#bc906b; font-size:12px; letter-spacing:4px; text-transform:uppercase; margin:0 0 16px;\">Levering, hverdager<\/p>\r\n        <p style=\"color:#ffffff; font-size:20px; margin:0;\">350 NOK<\/p>\r\n        <p style=\"color:#ffffff; font-size:13px; opacity:0.7; margin:6px 0 0;\">eks. mva.<\/p>\r\n      <\/div>\r\n      <div style=\"min-width:200px;\">\r\n        <p style=\"color:#bc906b; font-size:12px; letter-spacing:4px; text-transform:uppercase; margin:0 0 16px;\">Levering, helg<\/p>\r\n        <p style=\"color:#ffffff; font-size:20px; margin:0;\">500 NOK<\/p>\r\n        <p style=\"color:#ffffff; font-size:13px; opacity:0.7; margin:6px 0 0;\">eks. mva.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n\r\n  <!-- KOKK PAA STEDET: split, slika desno -->\r\n  <div style=\"display:flex; flex-wrap:wrap-reverse; background:#111111;\">\r\n    <div style=\"flex:1; min-width:320px; display:flex; align-items:center; justify-content:center; padding:80px 55px;\">\r\n      <div style=\"max-width:380px;\">\r\n        <p style=\"color:#bc906b; font-size:12px; letter-spacing:5px; text-transform:uppercase; margin:0 0 22px;\">Kokk p\u00e5 stedet<\/p>\r\n        <p style=\"color:#ffffff; font-size:16px; line-height:1.9; opacity:0.82; margin:0 0 22px;\">\r\n          For en komplett opplevelse kan en av v\u00e5re kokker v\u00e6re til stede for \u00e5 ferdigstille, anrette og presentere maten direkte p\u00e5 arrangementet. Serveringsfat er inkludert.\r\n        <\/p>\r\n        <p style=\"color:#bc906b; font-size:19px; margin:0;\">2.000 NOK eks. mva.<\/p>\r\n      <\/div>\r\n    <\/div>\r\n    <div style=\"flex:1; min-width:320px; min-height:420px; background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/09\/PorFavor-Tapas48398-scaled.jpg'); background-size:cover; background-position:center; filter:grayscale(10%);\"><\/div>\r\n  <\/div>\r\n\r\n  <!-- SERVERINGSFAT + BESTILLING -->\r\n  <div style=\"position:relative; padding:110px 20px;\">\r\n    <div style=\"position:absolute; inset:0; background-image:url('http:\/\/askerporfavor.no\/wp-content\/uploads\/2024\/01\/18824237-scaled.jpg'); background-size:cover; background-position:center; filter:blur(8px) brightness(0.22); transform:scale(1.1);\"><\/div>\r\n\r\n    <div style=\"position:relative; max-width:600px; margin:0 auto; text-align:center;\">\r\n      <p style=\"color:#bc906b; font-size:12px; letter-spacing:5px; text-transform:uppercase; margin:0 0 20px;\">Serveringsfat og utstyr<\/p>\r\n      <p style=\"color:#ffffff; font-size:15px; line-height:1.9; opacity:0.8; margin:0 0 20px;\">\r\n        Serveringsfat og annet utl\u00e5nt utstyr skal returneres til PorFavor Restaurant innen 48 timer etter arrangementet.\r\n      <\/p>\r\n      <p style=\"color:#ffffff; font-size:14px; opacity:0.65; margin:0 0 6px;\">Depositum<\/p>\r\n      <p style=\"color:#bc906b; font-size:17px; margin:0 0 70px;\">2.500 NOK<\/p>\r\n\r\n      <div style=\"width:60px; height:1px; background:#bc906b; margin:0 auto 70px;\"><\/div>\r\n\r\n      <p style=\"color:#bc906b; font-size:12px; letter-spacing:5px; text-transform:uppercase; margin:0 0 20px;\">Bestilling<\/p>\r\n      <p style=\"color:#ffffff; font-size:16px; line-height:1.9; opacity:0.85; margin:0;\">\r\n        Vi anbefaler at catering bestilles i god tid for \u00e5 sikre tilgjengelighet. Har du sp\u00f8rsm\u00e5l eller \u00f8nsker et skreddersydd tilbud, hjelper vi deg gjerne med \u00e5 skape en cateringopplevelse tilpasset ditt arrangement.\r\n      <\/p>\r\n    <\/div>\r\n  <\/div>\r\n\r\n<\/section>\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/div>\n\t\t\t\t\t<\/div>\n\t\t<\/section>\n\t\t\t\t<\/div>\n\t\t","protected":false},"excerpt":{"rendered":"<p>Catering PorFavor Catering Smaken av PorFavorservert der du \u00f8nsker det. Fra firmaarrangementer til private feiringer \u2013 vi tar med oss smaken og gjestfriheten fra restauranten, rett til ditt bord. V\u00e5r catering er laget for \u00e5 deles og best\u00e5r av et n\u00f8ye sammensatt utvalg av autentiske spanske retter, tilberedt med r\u00e5varer av h\u00f8y kvalitet og servert [&hellip;]<\/p>\n","protected":false},"author":3,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"elementor_header_footer","meta":{"inline_featured_image":false,"_mi_skip_tracking":false,"_monsterinsights_sitenote_active":false,"_monsterinsights_sitenote_note":"","_monsterinsights_sitenote_category":0,"footnotes":""},"class_list":["post-986","page","type-page","status-publish","hentry"],"yoast_head":"<!-- This site is optimized with the Yoast SEO Premium plugin v20.8 (Yoast SEO v20.8) - https:\/\/yoast.com\/wordpress\/plugins\/seo\/ -->\n<title>Velkommen til PorFavor Tapas &amp; Vinbar<\/title>\n<meta name=\"description\" content=\"Opplev gastronomisk magi og autentisk matglede med autentisk spansk kokekunst. V\u00e5r restaurant tilbyr en uts\u00f8kt meny inspirert av lokale r\u00e5varer og internasjonale smaker. Utforsk de deilige smakene av Spania og nyt e